# Server-side upstreams only. Never expose these through VITE_* variables.
# Fill every placeholder with the real upstream URL in your local .env (never commit it):
# n8n webhook paths act as credentials, so they must stay out of the repository.
N8N_CATALOG_CONFIG_UPSTREAM_BASE_URL=https://catalog-upstream.example/webhook/lrmq/catalog
N8N_CATALOG_PRODUCTS_UPSTREAM_BASE_URL=https://catalog-upstream.example/webhook/lrmq/catalog
N8N_CATALOG_QUOTE_REQUESTS_UPSTREAM_BASE_URL=https://catalog-upstream.example/webhook/lrmq/catalog
# Product detail uses a distinct deployed workflow route.
N8N_CATALOG_PRODUCT_DETAIL_UPSTREAM_BASE_URL=https://catalog-upstream.example/webhook/<detalle-workflow>/lrmq/catalog
# Assistant chat upstream (backend n8n to be added later; frontend posts to /api/chat/messages).
CHAT_UPSTREAM_BASE_URL=https://catalog-upstream.example/webhook/<asistente-workflow>/lrmq-chat-v1
# Value of the n8n Header Auth credential named LRMQ_Chat_Inbound; never commit the real value.
CHAT_UPSTREAM_AUTH_VALUE=<n8n-chat-header-secret>
# Demo adapter for the assistant UI: only loaded in dev when set to '1'. Never enable in production.
VITE_ENABLE_ASSISTANT_DEMO=
